# AAROH AI Backend — Environment Template
# Copy this to .env and fill in real values.
# NEVER commit .env to Git.

APP_NAME=AAROH AI
APP_VERSION=0.1.0
APP_ENV=development
DEBUG=true

HOST=127.0.0.1
PORT=8000

# Optional override. By default SQLite is stored under the user's local
# application-data directory, outside the source repository.
# DATABASE_URL=sqlite:///C:/Users/<user>/AppData/Local/AAROH/aaroh.sqlite3

# CORS — allow the Vite dev server
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# AI Provider: mock | claude | gemini | openai
PRIMARY_AI_PROVIDER=mock
PRIMARY_AI_MODEL=mock-v1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Future phases ────────────────────────────────────────────
# Uncomment and fill when upgrading from mock to real AI
# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# GOOGLE_API_KEY=your-key-here

